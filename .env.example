# 复制为 .env 并修改。切勿把真实 .env 提交到仓库。

# 监听端口
PORT=3000

# SQLite 文件所在目录（容器内默认 /data，已在 docker-compose 中挂载）
DATA_DIR=/data

# 必填。32 字节 base64，用于 AES-256-GCM 加密敏感字段。生成：openssl rand -base64 32
# 丢失或更换后，库里已加密的内容将无法解密。
ENCRYPTION_KEY=

# 必填。至少 32 个字符，用于签名会话 Cookie。生成：openssl rand -base64 48
SESSION_SECRET=

# 初始管理员密码。首次启动且库里没有密码哈希时用它初始化；之后请在“设置”页修改。
ADMIN_PASSWORD=

# 可选。SMTP 失效时的兜底登录密码；配置后始终可用密码方式登录。
EMERGENCY_PASSWORD=

# 通过 HTTPS 反代访问时保持 true；仅本机 http 调试时设为 false。
COOKIE_SECURE=true

# 是否信任反代传来的 X-Forwarded-For（用于登录失败按 IP 锁定）。
# 部署在 Nginx/Caddy 后保持 true；如果直接暴露端口则必须设为 false。
TRUST_PROXY=true

TZ=Asia/Shanghai
